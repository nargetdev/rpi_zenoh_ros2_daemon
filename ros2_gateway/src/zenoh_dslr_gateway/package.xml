<?xml version="1.0"?>
<package format="3">
  <name>zenoh_dslr_gateway</name>
  <version>0.1.0</version>
  <description>ROS 2 relay and test harness for a Zenoh-native DSLR capture service.</description>
  <maintainer email="devnull@example.com">OpenAI Codex</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>python3-pil</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
